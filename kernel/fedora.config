##
## Fedora-specific additions, merged last (after the Arch Linux ARM base
## config, the linux-surface spx.config fragment and overrides.config).
##

## SELinux: Fedora runs SELinux enforcing; the Arch base config leaves it off.
CONFIG_SECURITY=y
CONFIG_SECURITY_NETWORK=y
CONFIG_AUDIT=y
CONFIG_SECURITY_SELINUX=y
CONFIG_SECURITY_SELINUX_BOOTPARAM=y
CONFIG_SECURITY_SELINUX_DEVELOP=y
CONFIG_SECURITY_SELINUX_AVC_STATS=y
CONFIG_BPF_LSM=y
CONFIG_SECURITY_LANDLOCK=y
CONFIG_SECURITY_YAMA=y
CONFIG_LSM="lockdown,yama,integrity,selinux,bpf,landlock"

## Fedora ships compressed firmware and kernel modules.
CONFIG_FW_LOADER_COMPRESS=y
CONFIG_FW_LOADER_COMPRESS_XZ=y
CONFIG_FW_LOADER_COMPRESS_ZSTD=y

## Filesystems used by Fedora images: btrfs root, ext4 /boot, vfat ESP.
CONFIG_BTRFS_FS=y
CONFIG_BTRFS_FS_POSIX_ACL=y
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_VFAT_FS=y
CONFIG_FAT_DEFAULT_IOCHARSET="ascii"
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y
CONFIG_EROFS_FS=m
CONFIG_SQUASHFS=m
CONFIG_OVERLAY_FS=m

## zram swap (zram-generator is on by default in Fedora).
CONFIG_ZRAM=m
CONFIG_ZSMALLOC=y
CONFIG_CRYPTO_ZSTD=y
CONFIG_CRYPTO_LZO=y

## Boot from internal NVMe and USB without relying on the initramfs.
CONFIG_BLK_DEV_NVME=y
CONFIG_PCIE_QCOM=y
CONFIG_PHY_QCOM_QMP=y
CONFIG_USB_STORAGE=y
CONFIG_USB_UAS=y

## Handy for debugging and for tools that read the running config.
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y

## The release string is set by the build script.
CONFIG_LOCALVERSION=""
# CONFIG_LOCALVERSION_AUTO is not set

# FastRPC: needed for the sensor DSP (sdsp) and hexagonrpcd
CONFIG_QCOM_FASTRPC=m

# Ambient light sensor (TCS3430, patch 0010)
CONFIG_TCS3430=m
