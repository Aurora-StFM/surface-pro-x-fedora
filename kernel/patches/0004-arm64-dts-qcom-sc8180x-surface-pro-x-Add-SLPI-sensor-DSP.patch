+&remoteproc_slpi {
+	/*
+	 * Sensor DSP (Qualcomm "All-Ways Aware" hub: LSM6DSO, AK991x,
+	 * ADUX1080). The image is relocatable and the board already reserves
+	 * scss_mem (20 MiB, matches the image span 0x97300000-0x98700000).
+	 * Firmware from the Windows package surfaceprox_subextscss.
+	 */
+	status = "okay";
+	memory-region = <&scss_mem>;
+	firmware-name = "qcom/msft/surface/pro-x-sq2/qcslpi8180.mbn";
+};
+
 &remoteproc_mpss {
