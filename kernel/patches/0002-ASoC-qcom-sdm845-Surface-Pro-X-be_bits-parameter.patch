diff --git a/sound/soc/qcom/sdm845.c b/sound/soc/qcom/sdm845.c
index a233b8004..e6a3910df 100644
--- a/sound/soc/qcom/sdm845.c
+++ b/sound/soc/qcom/sdm845.c
@@ -538,6 +538,15 @@ static const struct snd_soc_ops sdm845_be_ops = {
 	.shutdown = sdm845_snd_shutdown,
 };
 
+/*
+ * Surface Pro X bring-up: sample width used on the DSP <-> codec backends.
+ * Changeable at runtime (/sys/module/snd_soc_sdm845/parameters/be_bits);
+ * takes effect on the next stream start.
+ */
+static int be_bits = 16;
+module_param(be_bits, int, 0644);
+MODULE_PARM_DESC(be_bits, "Backend (SLIMbus) sample width: 16 or 24");
+
 static int sdm845_be_hw_params_fixup(struct snd_soc_pcm_runtime *rtd,
 				struct snd_pcm_hw_params *params)
 {
@@ -549,7 +558,8 @@ static int sdm845_be_hw_params_fixup(struct snd_soc_pcm_runtime *rtd,
 
 	rate->min = rate->max = DEFAULT_SAMPLE_RATE_48K;
 	channels->min = channels->max = 2;
-	snd_mask_set_format(fmt, SNDRV_PCM_FORMAT_S16_LE);
+	snd_mask_set_format(fmt, be_bits == 24 ? SNDRV_PCM_FORMAT_S24_LE :
+						 SNDRV_PCM_FORMAT_S16_LE);
 
 	return 0;
 }
