# Surface Pro X Fedora kit: pinned versions.
# Change these to move to a newer kernel or Fedora release.
# Values already set in the environment win over the defaults below.

# Fedora release and edition of the base image.
: "${FEDORA_RELEASE:=44}"
: "${FEDORA_EDITION:=KDE}"
: "${FEDORA_MIRROR:=https://download.fedoraproject.org/pub/fedora/linux}"

# linux-surface kernel for the Surface Pro X (tag spx/v6.18.3).
: "${KERNEL_REPO:=https://github.com/linux-surface/kernel.git}"
: "${KERNEL_COMMIT:=3d83d8ff8b3c5ed045a7d576d2f0ccf2165d8c0b}"
: "${KERNEL_VERSION:=6.18.3}"
# Bump this when you rebuild the same kernel version with changes.
: "${KERNEL_PKG_RELEASE:=7}"

# Kernel configuration inputs. These are the same pins the linux-surface Arch
# package uses for 6.18.3.
: "${BASE_CONFIG_URL:=https://raw.githubusercontent.com/archlinuxarm/PKGBUILDs/e36ada85974d22c05d1442a4ac47f958c7fa8e15/core/linux-aarch64/config}"
: "${BASE_CONFIG_SHA256:=7224624cb815e7c4d989cea2d8c6abf25f02c280db66ce28e023e12cb177965f}"
: "${SPX_CONFIG_URL:=https://raw.githubusercontent.com/qzed/aarch64-kernel-configs/dc7be78b3d59f23405d4b49aae4c0c31123fcb10/fragments/spx.config}"
: "${SPX_CONFIG_SHA256:=6769de357507321f4332b1bbd20f4e3fd4460790f2ef4728d49ab9e2634f085a}"

# Firmware repository (used when you don't pass --from-windows).
: "${FIRMWARE_REPO:=https://github.com/linux-surface/aarch64-firmware.git}"
: "${FIRMWARE_COMMIT:=9f07579ee64aba56419cfd0fbbca9f26741edc90}"

# Kernel arguments the Surface Pro X needs (from the linux-surface wiki).
: "${SPX_KERNEL_ARGS:=efi=novamap clk_ignore_unused}"

# Extra space added to the Fedora image so the new kernel and firmware fit.
: "${IMAGE_EXTRA_GB:=4}"

# Where everything is written.
: "${OUT_DIR:=$PWD/out}"
