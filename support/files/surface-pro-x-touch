#!/bin/sh
# Run iptsd on the Surface Pro X touchscreen (hidraw node in $1).
#
# spi-hid powers the digitizer down whenever nobody has it open, and after
# opening it rejects requests (-ENODEV) until the digitizer has answered its
# reset. iptsd queries the device immediately after opening it, so open it
# here first, wait for spi-hid's "ready" flag, and keep it open while iptsd
# runs (iptsd inherits descriptor 3).
set -u
dev="$1"
ready="/sys/class/hidraw/${dev##*/}/device/../ready"

exec 3<"$dev" || exit 1
i=0
while [ $i -lt 50 ]; do
    [ -r "$ready" ] || { sleep 1; break; }
    [ "$(cat "$ready")" = ready ] && break
    sleep 0.1
    i=$((i + 1))
done
exec /usr/bin/iptsd "$dev"
