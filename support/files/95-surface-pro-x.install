#!/usr/bin/bash
# kernel-install plugin for the Surface Pro X.
#
# Runs after Fedora's 20-grub.install (which writes the BLS entry) and
# 50-dracut.install (which builds the initramfs). For kernels that ship the
# Surface Pro X device tree it:
#   - copies the DTB to /boot/dtb-<version>/
#   - adds a "devicetree" line to the kernel's BLS entry so GRUB loads it
#   - makes sure the kernel arguments the device needs are on the entry
# Kernels without the DTB (for example Fedora's stock kernel) are left alone.

COMMAND="$1"
KERNEL_VERSION="$2"

DTB_REL="qcom/sc8180x-surface-pro-x.dtb"
MODDIR="${SPX_TEST_ROOT:-}/usr/lib/modules/$KERNEL_VERSION"
BOOTDIR="${SPX_TEST_ROOT:-}/boot"
REQUIRED_ARGS="efi=novamap clk_ignore_unused"
[ -r /etc/surface-pro-x/kernel-args ] && REQUIRED_ARGS="$(tr '\n' ' ' < /etc/surface-pro-x/kernel-args)"

log() { [ "${KERNEL_INSTALL_VERBOSE:-0}" -gt 0 ] && echo "surface-pro-x: $*"; return 0; }

case "$COMMAND" in
    add)
        if [ ! -f "$MODDIR/dtb/$DTB_REL" ]; then
            log "no Surface Pro X DTB in $MODDIR, skipping"
            exit 0
        fi

        # Fedora's kernel-install reports layout "bls" on GRUB systems too
        # (the entries live in /boot/loader/entries), so only a UKI layout,
        # which has no separate devicetree line, is skipped.
        if [ "${KERNEL_INSTALL_LAYOUT:-}" = "uki" ]; then
            echo "surface-pro-x: layout 'uki' is not supported, add the devicetree to the boot entry yourself" >&2
            exit 0
        fi

        install -D -m 0644 "$MODDIR/dtb/$DTB_REL" "$BOOTDIR/dtb-$KERNEL_VERSION/$DTB_REL"

        shopt -s nullglob
        entries=("$BOOTDIR"/loader/entries/*-"$KERNEL_VERSION".conf)
        if [ ${#entries[@]} -eq 0 ]; then
            echo "surface-pro-x: no BLS entry found for $KERNEL_VERSION" >&2
            exit 1
        fi

        for entry in "${entries[@]}"; do
            # Paths in the entry are relative to the filesystem that holds it:
            # "/vmlinuz-..." with a separate /boot, "/boot/vmlinuz-..." without.
            linux_path="$(awk '$1 == "linux" { print $2; exit }' "$entry")"
            prefix="$(dirname "${linux_path:-/vmlinuz}")"
            [ "$prefix" = "/" ] && prefix=""
            dt_line="devicetree $prefix/dtb-$KERNEL_VERSION/$DTB_REL"

            tmp="$(mktemp "$entry.XXXXXX")"
            awk -v dt="$dt_line" -v req="$REQUIRED_ARGS" '
                BEGIN { n = split(req, args, " ") }
                # Fedora GRUB stops reading a BLS entry at the first line
                # without a "key value" pair, so blank lines must go.
                /^[[:space:]]*$/ { next }
                $1 == "devicetree" { next }
                $1 == "options" {
                    line = $0
                    for (i = 1; i <= n; i++) {
                        found = 0
                        for (j = 2; j <= NF; j++) if ($j == args[i]) found = 1
                        if (!found) line = line " " args[i]
                    }
                    print line
                    have_opts = 1
                    next
                }
                { print }
                END {
                    if (!have_opts) {
                        line = "options"
                        for (i = 1; i <= n; i++) line = line " " args[i]
                        print line
                    }
                    print dt
                }
            ' "$entry" > "$tmp" && chmod --reference="$entry" "$tmp" && mv -f "$tmp" "$entry"
            command -v restorecon >/dev/null 2>&1 && restorecon -q "$entry" 2>/dev/null
            log "updated $entry"
        done
        ;;
    remove)
        rm -rf "${BOOTDIR:?}/dtb-$KERNEL_VERSION"
        # Entries written while the image was built are named after a
        # temporary machine id, so Fedora's own plugin (which only looks for
        # this machine's id) leaves them behind when the kernel goes. Remove
        # every entry for this version, whatever id it is named after.
        rm -f "$BOOTDIR"/loader/entries/*-"$KERNEL_VERSION".conf
        ;;
esac

exit 0
